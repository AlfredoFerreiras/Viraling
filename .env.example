# Copy this file to .env.local and fill in the real values.
# .env* is gitignored: NEVER commit keys.

# Neon Postgres (pooled connection string, as the app_user role)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Owner connection, used only by the local migration scripts (db:migrate, db:rls).
# Leave unset in production.
ADMIN_DATABASE_URL=

# Anthropic (server only, never NEXT_PUBLIC)
ANTHROPIC_API_KEY=sk-ant-xxx

# Cloudflare R2 (admin reference images)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=formatbrain

# Upstash Redis (distributed rate limiting).
# Optional: without it, limits fall back to an in-memory window per instance.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# The app's own public URL. Drives the CORS allowlist in src/proxy.ts,
# so a wrong value makes the API reject every request with 403.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects the cron endpoint. The Netlify scheduled function sends it
# as a Bearer token. Generate a long random string.
CRON_SECRET=generate-a-long-random-string

# Shared demo account for portfolio visitors. When set, the landing page and
# the auth pages show a one click "Explore the demo" button that opens a
# session for exactly this account. Leave empty to disable the demo entirely.
DEMO_EMAIL=demo@viraling.app
